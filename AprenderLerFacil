                    </div>

                    <!-- Grade de Opções para Escolha Auditiva -->
                    <div id="gameOptionsGrid" class="grid grid-cols-2 gap-3 flex-1 items-center my-auto">
                        <!-- Opções dinâmicas -->
                    </div>

                    <div id="gameFeedback" class="text-center min-h-[30px] text-sm font-bold"></div>
                </div>

            </section>

            <!-- Bottom Navigation Bar (Navegação entre Módulos) -->
            <nav class="grid grid-cols-3 gap-2 pt-2 border-t border-white/10 z-20">
                <button data-nav="study" class="nav-btn btn-pop py-2.5 rounded-2xl bg-indigo-600 text-white font-bold text-xs flex flex-col items-center justify-center gap-0.5 shadow-md">
                    <span class="text-base">📚</span> Sílabas
                </button>
                <button data-nav="builder" class="nav-btn btn-pop py-2.5 rounded-2xl bg-white/10 hover:bg-white/20 text-slate-300 font-bold text-xs flex flex-col items-center justify-center gap-0.5">
                    <span class="text-base">🧩</span> Palavras
                </button>
                <button data-nav="game" class="nav-btn btn-pop py-2.5 rounded-2xl bg-white/10 hover:bg-white/20 text-slate-300 font-bold text-xs flex flex-col items-center justify-center gap-0.5">
                    <span class="text-base">🎧</span> Jogo do Som
                </button>
            </nav>

        </div>
    </main>

    <!-- Script Principal com Lógica de Sílabas, Speech Synthesis e Gamificação -->
    <script>
        // BANCO DE DADOS DE SÍLABAS E PALAVRAS PARA ALFABETIZAÇÃO
        const SYLLABLE_FAMILIES = [
            { consonant: 'B', syllables: ['BA', 'BE', 'BI', 'BO', 'BU'], example: { word: 'BOCA', emoji: '👄', syllables: ['BO', 'CA'] } },
            { consonant: 'C', syllables: ['CA', 'CE', 'CI', 'CO', 'CU'], example: { word: 'CASA', emoji: '🏠', syllables: ['CA', 'SA'] } },
            { consonant: 'D', syllables: ['DA', 'DE', 'DI', 'DO', 'DU'], example: { word: 'DADO', emoji: '🎲', syllables: ['DA', 'DO'] } },
            { consonant: 'F', syllables: ['FA', 'FE', 'FI', 'FO', 'FU'], example: { word: 'FOCA', emoji: '🦭', syllables: ['FO', 'CA'] } },
            { consonant: 'G', syllables: ['GA', 'GE', 'GI', 'GO', 'GU'], example: { word: 'GATO', emoji: '🐱', syllables: ['GA', 'TO'] } },
            { consonant: 'L', syllables: ['LA', 'LE', 'LI', 'LO', 'LU'], example: { word: 'LIXO', emoji: '🗑️', syllables: ['LI', 'XO'] } },
            { consonant: 'M', syllables: ['MA', 'ME', 'MI', 'MO', 'MU'], example: { word: 'MALA', emoji: '🧳', syllables: ['MA', 'LA'] } },
            { consonant: 'P', syllables: ['PA', 'PE', 'PI', 'PO', 'PU'], example: { word: 'PATO', emoji: '🦆', syllables: ['PA', 'TO'] } },
            { consonant: 'R', syllables: ['RA', 'RE', 'RI', 'RO', 'RU'], example: { word: 'RATO', emoji: '🐀', syllables: ['RA', 'TO'] } },
            { consonant: 'S', syllables: ['SA', 'SE', 'SI', 'SO', 'SU'], example: { word: 'SAPO', emoji: '🐸', syllables: ['SA', 'PO'] } },
            { consonant: 'T', syllables: ['TA', 'TE', 'TI', 'TO', 'TU'], example: { word: 'TATU', emoji: '🦔', syllables: ['TA', 'TU'] } },
            { consonant: 'V', syllables: ['VA', 'VE', 'VI', 'VO', 'VU'], example: { word: 'VACA', emoji: '🐮', syllables: ['VA', 'CA'] } },
            { consonant: 'Z', syllables: ['ZA', 'ZE', 'ZI', 'ZO', 'ZU'], example: { word: 'ZEBRA', emoji: '🦓', syllables: ['ZE', 'BRA'] } }
        ];

        const WORD_CHALLENGES = [
            { word: 'BOCA', emoji: '👄', syllables: ['BO', 'CA'], distractor: ['PA', 'TE'] },
            { word: 'SAPATO', emoji: '👞', syllables: ['SA', 'PA', 'TO'], distractor: ['LA', 'BO'] },
            { word: 'GATO', emoji: '🐱', syllables: ['GA', 'TO'], distractor: ['MI', 'FA'] },
            { word: 'BOLA', emoji: '⚽', syllables: ['BO', 'LA'], distractor: ['CA', 'PU'] },
            { word: 'PIPA', emoji: '🪁', syllables: ['PI', 'PA'], distractor: ['TA', 'VU'] },
            { word: 'BALEIA', emoji: '🐳', syllables: ['BA', 'LE', 'I', 'A'], distractor: ['CO', 'MO'] },
            { word: 'CAVALO', emoji: '🐎', syllables: ['CA', 'VA', 'LO'], distractor: ['ME', 'BI'] },
            { word: 'MACAKO', emoji: '🐒', syllables: ['MA', 'CA', 'CO'], distractor: ['DE', 'SU'] }
        ];

        // Estado do Aplicativo
        let currentFamilyIndex = 0;
        let currentBuilderChallengeIndex = 0;
        let userBuiltSyllables = [];
        let stars = 0;
        let audioMuted = false;

        let gameTargetItem = null; // Para o Jogo do Som

        // Web Audio API Synthesizer para Efeitos Sonoros Rápidos
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function playSoundFx(type) {
            if (audioMuted) return;
            try {
                if (!audioCtx) audioCtx = new AudioCtx();
                if (audioCtx.state === 'suspended') audioCtx.resume();

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                const now = audioCtx.currentTime;

                if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(450, now);
                    osc.frequency.exponentialRampToValueAtTime(150, now + 0.04);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.linearRampToValueAtTime(0.001, now + 0.04);
                    osc.start(now);
                    osc.stop(now + 0.04);
                } else if (type === 'success') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.setValueAtTime(659.25, now + 0.08); // E5
                    osc.frequency.setValueAtTime(783.99, now + 0.16); // G5
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.linearRampToValueAtTime(0.001, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'error') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.setValueAtTime(180, now + 0.08);
                    gain.gain.setValueAtTime(0.1, now);
                    gain.gain.linearRampToValueAtTime(0.001, now + 0.2);
                    osc.start(now);
                    osc.stop(now + 0.2);
                }
            } catch(e) {}
        }

        // Web Speech API (Locução em PT-BR)
        function speakText(text, rate = 0.85) {
            if (audioMuted) return;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Parar falas anteriores
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'pt-BR';
                utterance.rate = rate; // Velocidade ligeiramente pausada para clareza infantil
                utterance.pitch = 1.1; // Tom levemente mais agudo/amigável
                window.speechSynthesis.speak(utterance);
            }
        }

        function speakSyllableSequence(syllablesArray, finalWord) {
            if (audioMuted) return;
            let delay = 0;
            syllablesArray.forEach((syl, i) => {
                setTimeout(() => {
                    speakText(syl, 0.8);
                }, delay);
                delay += 750;
            });

            setTimeout(() => {
                speakText(finalWord, 0.9);
            }, delay + 200);
        }

        // --- INICIALIZAÇÃO E NAVEGAÇÃO ---
        document.addEventListener('DOMContentLoaded', () => {
            initConsonantsBar();
            loadFamily(0);
            initBuilderChallenge(0);
            initSoundGame();
            updateStarDisplay();

            // Navegação de Módulos
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    playSoundFx('click');
                    const nav = btn.dataset.nav;

                    // Atualizar visual dos botões
                    document.querySelectorAll('.nav-btn').forEach(b => {
                        b.classList.remove('bg-indigo-600', 'text-white');
                        b.classList.add('bg-white/10', 'text-slate-300');
                    });
                    btn.classList.remove('bg-white/10', 'text-slate-300');
                    btn.classList.add('bg-indigo-600', 'text-white');

                    // Mostrar/Ocultar containers
                    document.getElementById('moduleStudy').classList.toggle('hidden', nav !== 'study');
                    document.getElementById('moduleBuilder').classList.toggle('hidden', nav !== 'builder');
                    document.getElementById('moduleGame').classList.toggle('hidden', nav !== 'game');

                    if (nav === 'game') initSoundGame();
                });
            });

            // Toggle Audio Mute
            document.getElementById('toggleAudioBtn').addEventListener('click', () => {
                audioMuted = !audioMuted;
                document.getElementById('toggleAudioBtn').textContent = audioMuted ? '🔇' : '🔊';
                if (audioMuted && 'speechSynthesis' in 
