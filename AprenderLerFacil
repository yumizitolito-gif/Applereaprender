                    <div class="flex items-center gap-1.5 bg-amber-500/20 border border-amber-400/40 rounded-full px-3 py-1 backdrop-blur-md">
                        <span class="text-amber-400 text-lg">⭐</span>
                        <span id="starCounter" class="text-amber-300 font-extrabold text-base font-['Nunito']">0</span>
                    </div>

                    <button id="toggleAudioBtn" title="Ativar/Desativar Áudio" class="btn-pop w-10 h-10 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-lg">
                        🔊
                    </button>
                </div>
            </header>

            <!-- Área de Conteúdo dos Módulos (Trocado via JS) -->
            <section id="moduleContainer" class="flex-1 my-3 relative overflow-y-auto custom-scroll flex flex-col justify-center">

                <!-- MÓDULO 1: ESTUDO DE SÍLABAS -->
                <div id="moduleStudy" class="w-full flex flex-col h-full justify-between gap-3">
                    <div class="bg-white/5 rounded-2xl p-3 border border-white/10">
                        <p class="text-xs text-cyan-300 mb-2 font-semibold">1. Escolha uma família silábica:</p>
