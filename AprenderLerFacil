<!DOCTYPE html>
<html lang="pt-BR" class="h-full select-none">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Alfabetiza 2026 - Aprenda a Ler Brincando</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts 2026 Playful -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Nunito:wght@700;900&display=swap" rel="stylesheet">

    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        :root {
            --font-main: 'Fredoka', cursive, sans-serif;
            --font-num: 'Nunito', sans-serif;
        }

        body {
            font-family: var(--font-main);
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior: none;
            background: radial-gradient(circle at 50% 20%, #1e1b4b 0%, #0f172a 60%, #020617 100%);
        }

        /* Glassmorphism 2026 Kids */
        .glass-panel {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 2px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 2px rgba(255, 255, 255, 0.25);
        }

        /* Botões Táteis 3D Pop */
        .btn-pop {
            transition: all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
            user-select: none;
        }

        .btn-pop:active, .btn-pop.pressed {
            transform: scale(0.92) translateY(4px);
            box-shadow: 0 2px 0 shadow-transparent !important;
        }

        /* Card de Sílaba */
        .syllable-card {
            background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
            border: 3px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 20px rgba(236, 72, 153, 0.35);
        }

        .syllable-card:hover {
            transform: translateY(-4px) scale(1.03);
        }

        /* Efeito de Pulso Suave */
        @keyframes pulse-glow {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 15px rgba(56, 189, 248, 0.6)); }
            50% { transform: scale(1.05); filter: drop-shadow(0 0 25px rgba(236, 72, 153, 0.8)); }
        }

        .glow-pulse {
            animation: pulse-glow 3s infinite ease-in-out;
        }

        /* Scrollbar Personalizada */
        .custom-scroll::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.25);
            border-radius: 10px;
        }
    </style>
</head>
<body class="h-full w-full flex items-center justify-center p-2 sm:p-4 text-white overflow-hidden">

    <!-- Container Principal Responsivo -->
    <main class="w-full max-w-md h-full max-h-[920px] flex flex-col justify-between relative z-10">
        
        <!-- App Wrapper com Estática Glassmorphic -->
        <div class="glass-panel w-full h-full rounded-[36px] p-4 sm:p-5 flex flex-col justify-between relative overflow-hidden">
            
            <!-- Header Top Bar -->
            <header class="flex items-center justify-between z-20 pb-2 border-b border-white/10">
                <div class="flex items-center gap-2">
                    <span class="text-3xl">🔤</span>
                    <div>
                        <h1 class="text-lg font-bold leading-tight bg-clip-text text-transparent bg-gradient-to-r from-amber-300 via-pink-400 to-cyan-300">
                            ALFABETIZA 2026
                        </h1>
                        <p class="text-[10px] text-cyan-200 tracking-wider uppercase font-semibold">Aprenda a ler rindo!</p>
                    </div>
                </div>

                <!-- Placard de Estrelas & Voz -->
