                        <h2 id="familyTitle" class="text-sm font-bold text-pink-300 uppercase mb-3 tracking-wider">Família do B</h2>
                        
                        <div id="syllablesGrid" class="grid grid-cols-5 gap-2 w-full mb-4">
                            <!-- Cartões de Sílaba (BA, BE, BI...) -->
                        </div>

                        <!-- Card de Palavra Exemplo -->
